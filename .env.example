# ---- App ----
ENV=dev
JWT_SECRET=change-me

# ---- Infra (matches docker-compose) ----
DATABASE_URL=postgresql+psycopg://vistaar:vistaar@db:5432/vistaar
REDIS_URL=redis://redis:6379/0

# ---- LLM providers (fallback order: Gemini -> Groq -> offline rules) ----
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# ---- Guardrails (deterministic, LLM never overrides these) ----
K_ANONYMITY_MIN=5
DP_EPSILON=1.0
MIN_MARGIN_PCT=8
MAX_DISCOUNT_PCT=15

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Tuning (all optional) ----
VISTAAR_NEARBY_KM=3
VISTAAR_FORECAST_DAYS=14
VISTAAR_BULK_HORIZON=14
VISTAAR_SESSION_HOURS=72
# Keyed hash for customer phone numbers (udhaar network). Change it, keep it out of the database.
VISTAAR_PHONE_SECRET=change-me-too

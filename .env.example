# ---- App ----
# ENV=dev allows the default secrets below. Any other value (for example production) makes the API
# refuse to start while VISTAAR_PHONE_SECRET is a default or shorter than 16 characters.
ENV=dev
JWT_SECRET=change-me
# Comma-separated frontend URL(s) allowed to call the API
CORS_ORIGINS=http://localhost:3000

# ---- Infra (matches docker-compose) ----
DATABASE_URL=postgresql+psycopg://vistaar:vistaar@db:5432/vistaar
REDIS_URL=redis://redis:6379/0

# ---- LLM providers (fallback order: Gemini -> Groq -> offline rules) ----
GEMINI_API_KEY=
GROQ_API_KEY=
SARVAM_API_KEY=

# ---- Guardrails (deterministic, LLM never overrides these) ----
K_ANONYMITY_MIN=5
DP_EPSILON=1.0
MIN_MARGIN_PCT=8
MAX_DISCOUNT_PCT=15

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Tuning (all optional) ----
VISTAAR_NEARBY_KM=3
VISTAAR_FORECAST_DAYS=14
VISTAAR_BULK_HORIZON=14
VISTAAR_SESSION_HOURS=72
# Login: wrong passwords allowed per phone in the window (seconds); registrations allowed per IP per hour.
# Behind a reverse proxy start uvicorn with --proxy-headers so the real client IP is used.
VISTAAR_LOGIN_MAX_FAILURES=5
VISTAAR_LOGIN_WINDOW_S=900
VISTAAR_REGISTER_MAX_PER_IP=20
# Keyed hash for customer phone numbers (udhaar network). Change it, keep it out of the database.
VISTAAR_PHONE_SECRET=change-me-too